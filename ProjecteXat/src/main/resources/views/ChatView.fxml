<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.projectexat.client.ui.controllers.ChatController"
            stylesheets="@/css/chat.css"
            styleClass="root">

    <!-- ══ TOP BAR ══ -->
    <top>
        <HBox spacing="0.0" alignment="CENTER_LEFT" styleClass="top-bar">

            <!-- Logo -->
            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="top-brand">
                <Label styleClass="top-logo" text="⬡"/>
                <VBox alignment="CENTER_LEFT" spacing="1.0">
                    <Label styleClass="top-title" text="Projecte Xat"/>
                    <HBox spacing="5.0" alignment="CENTER_LEFT">
                        <Label styleClass="status-dot" text="●"/>
                        <Label styleClass="status-text" text="Connectat"/>
                    </HBox>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Accions -->
            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button fx:id="btnDisconnect" styleClass="disconnect-button"
                        onAction="#handleDisconnect" text="✕  Desconnectar"/>
            </HBox>

        </HBox>
    </top>

    <!-- ══ PANELL ESQUERRE: usuaris ══ -->
    <left>
        <VBox prefWidth="180.0" styleClass="users-panel">

            <!-- Header -->
            <HBox styleClass="users-header" alignment="CENTER_LEFT" spacing="8.0">
                <Label styleClass="users-header-icon" text="◈"/>
                <Label styleClass="panel-header" text="EN LÍNIA"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblOnlineCount" styleClass="online-badge" text="0"/>
            </HBox>

            <Region styleClass="users-divider" prefHeight="1.0" minHeight="1.0" maxHeight="1.0"/>

            <!-- Llista -->
            <ListView fx:id="lvUsers" VBox.vgrow="ALWAYS" styleClass="users-list"/>

        </VBox>
    </left>

    <!-- ══ CENTRE: missatges + input ══ -->
    <center>
        <VBox styleClass="chat-area">

            <!-- Missatges -->
            <ListView fx:id="lvMessages" VBox.vgrow="ALWAYS" styleClass="messages-list"/>

            <!-- INPUT PANEL -->
            <VBox styleClass="input-panel" spacing="8.0">

                <!-- Camp de text + botó enviar en una sola fila -->
                <HBox spacing="10.0" alignment="CENTER">
                    <TextArea fx:id="taInput"
                              promptText="Escriu el teu missatge..."
                              wrapText="true"
                              prefHeight="48.0"
                              maxHeight="80.0"
                              styleClass="message-input"
                              HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnSend" text="➤" onAction="#handleSend"
                            styleClass="send-button"/>
                </HBox>

                <!-- Fila historial (discreta) -->
                <HBox spacing="8.0" alignment="CENTER_RIGHT">
                    <DatePicker fx:id="dpHistory" promptText="dd/mm/aaaa"
                                styleClass="date-picker" prefWidth="145.0"/>
                    <Button fx:id="btnHistory" text="Historial" onAction="#handleHistory"
                            styleClass="history-button"/>
                </HBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>
